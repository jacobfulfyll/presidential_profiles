# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Data caches (raw downloads regenerated by the fetch script)
data/raw/

# Raw batch request/result artifacts (tens of MB per run; refetchable from the
# API for 29 days). The provenance record is the manifest + parquet, which ARE
# tracked — this is only the scratch space ingest replays from.
data/llm_annotations/runs/

# Data Trust study identities and blinded task plans are local-only. The five
# declared public-safe protocol receipts remain trackable at the v1 root.
data/validation_protocols/v1/restricted/

# ML model caches
.cache/

# Secrets / local env (API keys for the LLM-annotation / taxonomy pipelines;
# sourced manually — no dotenv loader in this project)
.env
.env.*

# OS
.DS_Store

# IDE
.idea/
.vscode/

.pipeline/
.worktree/

# Local tool telemetry is never part of a portable release.
.claude/stats.json

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
