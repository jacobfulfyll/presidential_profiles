# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Data caches (raw downloads regenerated by the fetch script)
data/raw/

# Raw batch request/result artifacts (tens of MB per run; refetchable from the
